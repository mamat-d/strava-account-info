# Strava API Credentials
# Create your app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Tokens (run auth.py to generate these automatically)
STRAVA_ACCESS_TOKEN=your_access_token_here
STRAVA_REFRESH_TOKEN=your_refresh_token_here

# Export settings
EXPORT_DIR=./export
EXPORT_FORMATS=json,csv         # Options: json, csv, gpx
INCLUDE_STREAMS=true            # Download GPS/HR/power streams (slower)
INCLUDE_PHOTOS=false            # Download activity photos
MAX_ACTIVITIES=0                # 0 = all activities
